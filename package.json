{
  "name": "niddle",
  "version": "0.0.1",
  "private": true,
  "license": "GPL-3.0-only",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "build:api": "npm run build -w apps/api",
    "build:web": "npm run build -w apps/web",
    "build": "npm run build:api && npm run build:web",
    "format": "biome format --write ./apps",
    "format:check": "biome check ./apps",
    "lint": "biome lint ./apps",
    "lint:fix": "biome lint --write ./apps",
    "check": "biome check ./apps",
    "check:fix": "biome check --write ./apps",
    "seed": "npm run seed -w apps/api",
    "schema:create": "npm run schema:create -w apps/api",
    "test": "npm test -w apps/api",
    "test:watch": "npm run test:watch -w apps/api",
    "test:cov": "npm run test:cov -w apps/api",
    "test:e2e": "npm run test:e2e -w apps/api"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "concurrently": "^8.2.2"
  }
}
